# ==============================================================================
# ETHENENGINE Platform Configuration Environment Template (.env)
# ==============================================================================

# Server Runtime Configuration
NODE_ENV=development
PORT=3000

# PostgreSQL Database (Aiven Cloud or Render PostgreSQL)
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=

# Local Docker PostgreSQL (optional fallback for dual-write sync)
DOCKER_DATABASE_URL=postgres://platform:secretpassword@localhost:5432/ethenenginedb
DB_PASSWORD=secretpassword

# Security & Zero-Knowledge Cryptography
JWT_SECRET=ethenengine-super-secret-jwt-key-2026
MASTER_ENCRYPTION_SECRET=platform_root_master_key_9837492837492834
ENCRYPTION_KEY=

# Polyglot High-Performance Rust Microservices
RUST_SERVICE_URL=http://localhost:8080

# Email & Notification Services (SMTP / Mailcow)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_FROM=noreply@ethenengine.com
SMTP_USER=
SMTP_PASS=

# Subsystem Flags
ENABLE_COMMERCE=true
ENABLE_MARKETPLACE=true
ENABLE_WORKFLOWS=true
STORAGE_PROVIDER=local
